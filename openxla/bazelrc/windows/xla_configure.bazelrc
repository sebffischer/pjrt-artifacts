# Windows CPU build with a local clang-cl, as JAX builds jaxlib locally on
# Windows (its win_clang, avx_windows and clang configs). XLA's .bazelrc
# imports this file and applies its own `windows` config on top.
# Bazel finds LLVM in its default location, C:\Program Files\LLVM.

common --config=clang_local
common --compiler=clang-cl
common --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl
# Added by openxla/patches/windows. XLA's own win_clang config points at a
# TensorFlow-only platform.
common --extra_execution_platforms=//tools/toolchains/win_clang_cl:x64_windows-clang-cl

# Error on struct/class mismatches, which cause link failures on Windows.
common --copt=-Werror=mismatched-tags
common --copt=-Wno-gnu-offsetof-extensions
common --copt=-Qunused-arguments
common --copt=-Wno-error=c23-extensions

common --copt=-march=haswell
common --host_copt=-march=haswell
