From a4ad6bf9639eed6f76e92d74794d47a4c876be80 Mon Sep 17 00:00:00 2001
From: Corentin Kerisit <corentin.kerisit@gmail.com>
Date: Thu, 2 Jul 2026 19:21:45 +0200
Subject: [PATCH 3/4] Hermetic cc toolchain

---
 MODULE.bazel | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/MODULE.bazel b/MODULE.bazel
index 3a207154..bb4391a6 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -6,6 +6,7 @@ module(name = "xla")
 # go/keep-sorted start
 bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")
 bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "absl_py")
+bazel_dep(name = "apple_support", version = "1.24.4", repo_name = "build_bazel_apple_support")
 bazel_dep(name = "bazel_clang_tidy", dev_dependency = True)
 bazel_dep(name = "bazel_features", version = "1.43.0")
 bazel_dep(name = "bazel_skylib", version = "1.9.0")
@@ -31,9 +32,14 @@ bazel_dep(name = "rules_license", version = "1.0.0")
 bazel_dep(name = "rules_python", version = "2.2.0")
 bazel_dep(name = "rules_shell", version = "0.8.0")
 bazel_dep(name = "snappy", version = "1.2.1")
+bazel_dep(name = "llvm", version = "0.8.11")
 bazel_dep(name = "zlib", version = "1.3.2")
 # go/keep-sorted end
 
+register_toolchains(
+    "@llvm//toolchain:all",
+)
+
 # Only for compatibility, not directly used
 bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.3", repo_name = None)
 bazel_dep(name = "grpc-java", version = "1.75.0", repo_name = None)
@@ -232,6 +238,14 @@ use_repo(tsl_extension, "tsl")
 llvm = use_extension("//third_party/extensions:llvm.bzl", "llvm_extension")
 use_repo(llvm, "llvm-project")
 
+osx = use_extension("@llvm//extensions:osx.bzl", "osx")
+osx.from_archive(
+    sha256 = "1bde70c0b1c2ab89ff454acbebf6741390d7b7eb149ca2a3ca24cc9203a408b7",
+    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.4.sdk",
+    type = "pkg",
+    urls = ["https://mirror.zml.ai/macos_sdks/26.4/CLTools_macOSNMOS_SDK.pkg"],
+)
+
 ### pybind
 pybind11_internal_configure = use_extension(
     "@pybind11_bazel//:internal_configure.bzl",
-- 
2.25.1

